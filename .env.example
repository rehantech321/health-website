# DATABASE_URL goes in .env (not here) - the Prisma CLI only reads .env.
#
# Everything below is optional. Copy this file to .env.local and fill in what
# you have; anything left blank runs in a clearly-labelled mock mode instead
# of failing.

# ---- Claude ----------------------------------------------------------------
# Without this, intake serves a fixed, clinically conservative question set
# and the clinician summary is built from verbatim answers only. Both are
# labelled as not AI-generated, in the UI and in the stored record.
ANTHROPIC_API_KEY=""

# ---- Stripe ----------------------------------------------------------------
# Without these, checkout redirects to /mock-checkout instead of Stripe's
# hosted page and no money moves. Klarna must be enabled on the Stripe account
# for "Pay later" to appear on the real hosted page.
STRIPE_SECRET_KEY=""
# From `stripe listen --forward-to localhost:3000/api/payments/webhook`,
# or the endpoint's signing secret in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=""

# ---- Email --------------------------------------------------------------
# Option A (recommended): your Namecheap Private Email mailbox over SMTP. Mail
# leaves from the real address, signed by the domain's own DKIM/SPF.
#   host: mail.privateemail.com   port: 465 (SSL) or 587 (STARTTLS)
#   user: the full mailbox address   pass: that mailbox's password
SMTP_HOST="mail.privateemail.com"
SMTP_PORT="465"
SMTP_USER="telehealth@eldava.com"
SMTP_PASS=""
# Must be the SMTP mailbox (or one of its aliases), or receivers reject it.
MAIL_FROM="Eldava Health <telehealth@eldava.com>"
# Where new-booking notices go. Defaults to SMTP_USER.
ADMIN_EMAIL="telehealth@eldava.com"

# Option B: Resend's API instead of SMTP. Ignored when SMTP_* is set.
RESEND_API_KEY=""

# ---- Site ------------------------------------------------------------------
# Used for Stripe return URLs and links in emails. Leave unset locally and it
# is derived from the request host.
NEXT_PUBLIC_SITE_URL=""
